{
  "description": "ZCode bridge lifecycle, result notification, and optional stop review gate.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/session-lifecycle-hook.mjs\"", "timeout": 5, "statusMessage": "Initializing ZCode bridge", "additionalContextLimit": 1200 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/user-prompt-hook.mjs\"", "timeout": 10, "statusMessage": "Checking ZCode jobs", "additionalContextLimit": 1800 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/subagent-hook.mjs\"", "timeout": 5, "additionalContextLimit": 1000 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/subagent-hook.mjs\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/stop-review-gate-hook.mjs\"", "timeout": 900, "statusMessage": "Running ZCode review gate" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/session-end-hook.mjs\"", "timeout": 3 }] }]
  }
}
