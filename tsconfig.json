{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.mjs"],
  "exclude": [
    "coverage",
    "node_modules",
    ".planning",
    ".worktrees"
  ]
}
